cat > .env.example <<'EOF'
# Pinned Silo image release
SILO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-09-03T13-18-01Z

# Root credentials for local lab only
MINIO_ROOT_USER=labadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Local lab ports
SILO_API_PORT=9000
SILO_CONSOLE_PORT=9001

# Monitoring
PROMETHEUS_PORT=9090
