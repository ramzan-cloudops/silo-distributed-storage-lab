cat > .gitignore <<'EOF'
# Secrets and environment files
.env
.env.*
!.env.example

# Silo object data
data/*

# Benchmark output
benchmarks/results/
benchmarks/downloads/
benchmarks/test-data/10mb.bin

# Python
__pycache__/
*.py[cod]
.venv/

# Logs
*.log

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
EOF
